#include <zephyr/dt-bindings/pinctrl/nrf-pinctrl.h>

/*
 * Example user overlay. Change the NRF_PSEL port/pin values below and add
 * this file to the dongle build with EXTRA_DTC_OVERLAY_FILE.
 *
 * P0.08 example: NRF_PSEL(UART_TX, 0, 8)
 */

&pinctrl {
    spectrum_dongle_uart_user_default: spectrum_dongle_uart_user_default {
        group1 {
            psels = <NRF_PSEL(UART_TX, 0, 8)>;
        };
    };

    spectrum_dongle_uart_user_sleep: spectrum_dongle_uart_user_sleep {
        group1 {
            psels = <NRF_PSEL(UART_TX, 0, 8)>;
            low-power-enable;
        };
    };
};

&uart0 {
    pinctrl-0 = <&spectrum_dongle_uart_user_default>;
    pinctrl-1 = <&spectrum_dongle_uart_user_sleep>;
};

